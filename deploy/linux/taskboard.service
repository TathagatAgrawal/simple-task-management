# Template for /etc/systemd/system/taskboard.service. install.sh fills in the @...@ values.
[Unit]
Description=Task board
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@UV@ run --no-dev simple-task-management serve --host 127.0.0.1 --port @PORT@
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
