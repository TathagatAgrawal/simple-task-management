# Copy to .env and adjust. Relative paths are relative to this folder.

# Where the live database lives. Do NOT put this inside OneDrive / Google Drive.
DATA_DIR=data

# Where nightly backups go. A cloud-synced folder is ideal, e.g.
# BACKUP_DIR=C:\Users\Office\OneDrive\TaskBoard-backups
BACKUP_DIR=backups

# Daily-rotated log files (kept 14 days).
LOG_DIR=logs

# The firm's timezone, used for "today" and for showing times.
TIMEZONE=Asia/Kolkata

# Nightly backup hour (24h, firm timezone) and how many backups to keep.
BACKUP_HOUR=23
BACKUP_KEEP=30

# Look for a newer version on GitHub every few hours, so admins can see "A newer version is
# available" in the app (user menu, Updates). It only looks: installing is done by update.ps1.
# Set UPDATE_CHECK=0 to turn the looking off.
UPDATE_CHECK=1
UPDATE_CHECK_HOURS=6

# Alerts that reach a phone or computer even when the board is closed (Web Push). People turn
# them on for their own device in the notification settings. PUSH=0 turns the feature off.
# PUSH_CONTACT is the address push services keep on file; the default works.
PUSH=1
PUSH_CONTACT=mailto:taskboard@example.com
